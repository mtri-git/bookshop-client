# Public URL of bookshop-api (used by the browser and by SSR)
VITE_HOST=https://bookshop-api.onrender.com
# Google Identity Services client id (must match GOOGLE_CLIENT_ID on the API)
VITE_GOOGLE_CLIENT_ID=
# Cloudinary unsigned upload endpoint + preset for avatars
VITE_CLOUDINARY_API=https://api.cloudinary.com/v1_1/du3l8upse/upload
VITE_CLOUDINARY_PRESET=wb0t30bu
